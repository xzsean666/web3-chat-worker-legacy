{
  "name": "web3-chat-worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker Web3 Chat MVP with EVM login, D1 SQLite, R2 voice storage, and ephemeral burn-on-read messaging",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
