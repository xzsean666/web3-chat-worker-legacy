    "test:live": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types scripts/live-e2e.ts"
  },
  "dependencies": {
    "hono": "^4.7.2",
    "viem": "^2.23.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^26.4.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.31.0"
  }
}
